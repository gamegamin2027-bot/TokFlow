# --- TokFlow : variables d'environnement ---
# URL publique du site (métadonnées, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base PostgreSQL : obligatoire en production (centre d'assistance, compte fondateur).
# En développement, laissez vide : une base embarquée (PGlite) est créée dans .data/.
DATABASE_URL=

# Réponses par e-mail depuis le Centre de support (https://resend.com)
RESEND_API_KEY=
# Expéditeur, sur un domaine vérifié chez Resend. Ex. : TokFlow <support@votre-domaine.fr>
EMAIL_FROM=
# Facultatif : adresse qui reçoit les réponses des utilisateurs
EMAIL_REPLY_TO=

# Moteur de récupération par lien : "ytdlp" (défaut) ou "none"
TOKFLOW_LINK_ENGINE=ytdlp
# Chemins des binaires (déjà dans le PATH de l'image Docker)
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
# Facultatif : proxy sortant du moteur, si TikTok refuse l'adresse du serveur.
# Formats : http://utilisateur:motdepasse@hote:port ou socks5://hote:port
# TOKFLOW_PROXY_URL=
# Secours gratuit : TOKFLOW_TOR=1 fait passer le moteur par un relais Tor embarqué dans l'image Docker.
# TOKFLOW_TOR=0
# Facultatif : vidéo publique témoin servant à distinguer « vidéo supprimée » de « serveur refusé par TikTok »
# TOKFLOW_CANARY_URL=

# Limites de traitement
MAX_UPLOAD_MB=200
MAX_DURATION_SECONDS=900
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=180
RATE_LIMIT_ANALYZE_PER_MIN=30
RATE_LIMIT_JOBS_PER_10MIN=15
RATE_LIMIT_SUPPORT_PER_HOUR=5

# --- Bannières (carrousels de photos) ---
# Source des animations (« Live Photos ») : "tikwm" (défaut, service tiers non officiel) ou "none" (images seules).
# En cas de panne de la source, les images restent proposées.
BANNER_CLIP_SOURCE=tikwm
# Facultatif : accès avec clé (https://tikwmapi.com). Sans clé, l'accès gratuit est limité à environ 1 requête/seconde.
# TIKWM_API_URL=https://www.tikwm.com/api/
# TIKWM_API_KEY=
RATE_LIMIT_BANNERS_PER_10MIN=12
RATE_LIMIT_BANNER_ZIPS_PER_10MIN=20
RATE_LIMIT_BANNER_FILES_PER_10MIN=900
